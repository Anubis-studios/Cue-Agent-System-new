{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "backend/api/index.py": { "memory": 1024, "maxDuration": 60 },
    "worker/index.py": { "memory": 1024, "maxDuration": 300 }
  },
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/next" },
    { "src": "backend/api/index.py", "use": "@vercel/python@4.4.0" },
    { "src": "worker/index.py", "use": "@vercel/python@4.4.0" }
  ],
  "routes": [
    { "src": "/cron/worker-tick", "dest": "worker/index.py" },
    { "src": "/api/(.*)", "dest": "backend/api/index.py" },
    { "src": "/ws/(.*)", "dest": "backend/api/index.py" },
    { "src": "/health", "dest": "backend/api/index.py" },
    { "src": "/docs", "dest": "backend/api/index.py" },
    { "src": "/openapi.json", "dest": "backend/api/index.py" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ],
  "crons": [
    { "path": "/cron/worker-tick", "schedule": "*/10 * * * *" }
  ]
}
