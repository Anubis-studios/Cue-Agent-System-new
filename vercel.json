{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi"
    },
    "cue-frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "cue-worker": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "worker/index.py",
      "buildCommand": "pip install -r backend/requirements.txt"
    }
  },
  "rewrites": [
    {
      "source": "/cron/worker-tick",
      "destination": {
        "service": "cue-worker"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/ws/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "cue-frontend"
      }
    }
  ],
  "crons": [
    {
      "path": "/cron/worker-tick",
      "schedule": "*/10 * * * *"
    }
  ]
}
